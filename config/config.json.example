{
  "port": "4433",
  "custom_mtu": 1200,
  "safe_root": "/path/to/your/merge_pool",
  "log_path": "/path/to/your/logs/quic.log",
  "tls_crt": "your_domain.crt",
  "tls_key": "your_domain.key",
  "max_fail_attempts": 5,
  "ban_duration_minutes": 15,
  "users": {
    "example_user": {
      "password": "YOUR_PLAIN_PASSWORD_HERE_WILL_BE_HASHED",
      "path": "/path/to/user/isolated/folder",
      "permission": "read_write"
    }
  }
}
